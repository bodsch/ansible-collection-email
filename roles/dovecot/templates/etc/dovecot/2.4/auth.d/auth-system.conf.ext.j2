#jinja2: trim_blocks: True, lstrip_blocks: True
{% import 'jinja_macros.j2' as mcr with context %}
# {{ ansible_managed }}
# Authentication for system users

{#
  dovecot 2.4 requires passdb and userdb blocks to be named:
    passdb { driver = x }  ->  passdb x { driver = x }
  The 'args' setting no longer exists; each driver has its own settings.
#}
{% if dovecot_authentications.system is defined and
      dovecot_authentications.system | count > 0 %}
  {% for _section, _values in dovecot_authentications.system.items() %}
    {% if _values | bodsch.core.type == "dict" and _values | count > 0 %}
{{ mcr.auth_db(_section, _values.driver | default('system'), _values) }}
    {% endif %}
  {% endfor %}
{% endif %}
