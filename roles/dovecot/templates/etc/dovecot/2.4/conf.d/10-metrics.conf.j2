#jinja2: trim_blocks: True, lstrip_blocks: True
# {{ ansible_managed }}

{#
  New in 2.4. Statistics are gathered from events through "metric" blocks and
  need no plugin. This replaces the old auth_stats setting and the old-stats
  plugin, both of which were removed.

  See https://doc.dovecot.org/latest/core/config/statistics.html

  What a metric becomes is decided by

    bodsch.email.dovecot_metrics

  which expands the compact "field:method:args" group_by notation into the
  nested blocks 2.4 wants, and rejects a metric dovecot would refuse. It
  returns WHAT to write, this template decides HOW it looks - the same split
  as dovecot_plugin_setting in 90-plugin.conf.
#}
{% set _metrics = dovecot_metrics.metrics | default([]) | bodsch.email.dovecot_metrics %}
{% for metric in _metrics %}
metric {{ metric.name }} {
  {% for key, value in metric.settings %}
  {{ "%-27s" | format(key) }} = {{ value }}
  {% endfor %}
{#
  group_by is a named list filter in 2.4, not a setting. A field without a
  method gets an empty block: discrete is the default.
#}
  {% for group in metric.group_by %}
  group_by {{ group.field }} {
    {% if group.method %}
    method {{ group.method }} {
      {% for key, value in group.arguments %}
      {{ "%-23s" | format(key) }} = {{ value }}
      {% endfor %}
    }
    {% endif %}
  }
  {% endfor %}
}
{% endfor %}
{#
  An exporter named after its driver needs no driver setting; any other name
  does, because event_exporter_driver defaults to "log".
#}
{% if dovecot_metrics.event_exporters is defined and
      dovecot_metrics.event_exporters | count > 0 %}
  {% for exporter in dovecot_metrics.event_exporters %}
    {% for name, values in exporter.items() %}
event_exporter {{ name }} {
      {% for k, v in (values | default({})).items() %}
        {% if v | string | length > 0 %}
  {{ "%-27s" | format(k) }} = {{ v }}
        {% endif %}
      {% endfor %}
}
    {% endfor %}
  {% endfor %}
{% endif %}
{#
  Prometheus scrapes /metrics from the http listener of the stats service.
#}
{% if dovecot_metrics.prometheus is defined and
      dovecot_metrics.prometheus.enabled is defined and
      dovecot_metrics.prometheus.enabled | bool %}
service stats {
  inet_listener http {
    port                      = {{ dovecot_metrics.prometheus.port | default(9900) | int }}
  {% if dovecot_metrics.prometheus.address is defined and
        dovecot_metrics.prometheus.address | string | length > 0 %}
    listen                    = {{ dovecot_metrics.prometheus.address }}
  {% endif %}
  }
}
{% endif %}
