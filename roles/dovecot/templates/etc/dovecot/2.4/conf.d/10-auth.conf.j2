#jinja2: trim_blocks: True, lstrip_blocks: True
{% import 'jinja_macros.j2' as mcr with context %}
# {{ ansible_managed }}

{#
  2.3 -> 2.4 mapping
    disable_plaintext_auth  -> auth_allow_cleartext   (inverted!)
    auth_default_realm      -> auth_default_domain
    auth_worker_max_count   -> service auth-worker { process_limit }  (see 10-master.conf)
    auth_debug              -> log_debug = category=auth             (see 10-logging.conf)
    auth_stats              -> removed, use metrics                  (see 10-metrics.conf)
#}
{% if dovecot_auth.disable_plaintext_auth is defined and
      dovecot_auth.disable_plaintext_auth | string | length > 0 %}
auth_allow_cleartext         = {{ (not (dovecot_auth.disable_plaintext_auth | bool)) | bodsch.core.config_bool(true_as='yes', false_as='no') }}
{% endif %}
{% if dovecot_auth.cache_size is defined and
      dovecot_auth.cache_size | string | length > 0 %}
auth_cache_size              = {{ dovecot_auth.cache_size | int }}
{% endif %}
{% if dovecot_auth.cache_ttl is defined and
      dovecot_auth.cache_ttl | string | length > 0 %}
auth_cache_ttl               = {{ dovecot_auth.cache_ttl }}
{% endif %}
{% if dovecot_auth.cache_negative_ttl is defined and
      dovecot_auth.cache_negative_ttl | string | length > 0 %}
auth_cache_negative_ttl      = {{ dovecot_auth.cache_negative_ttl }}
{% endif %}
{% if dovecot_auth.cache_verify_password_with_worker is defined and
      dovecot_auth.cache_verify_password_with_worker | string | length > 0 %}
auth_cache_verify_password_with_worker = {{ dovecot_auth.cache_verify_password_with_worker | bodsch.core.config_bool(true_as='yes', false_as='no') }}
{% endif %}
{% if dovecot_auth.realms is defined and
      dovecot_auth.realms | count > 0 %}
auth_realms                  = {{ dovecot_auth.realms | join(' ') }}
{% endif %}
{% if dovecot_auth.default_realm is defined and
      dovecot_auth.default_realm | string | length > 0 %}
auth_default_domain          = {{ dovecot_auth.default_realm }}
{% endif %}
{% if dovecot_auth.username_chars is defined and
      dovecot_auth.username_chars | string | length > 0 %}
auth_username_chars          = {{ dovecot_auth.username_chars }}
{% endif %}
{% if dovecot_auth.username_translation is defined and
      dovecot_auth.username_translation | string | length > 0 %}
auth_username_translation    = {{ dovecot_auth.username_translation }}
{% endif %}
{% if dovecot_auth.username_format is defined and
      dovecot_auth.username_format | string | length > 0 %}
auth_username_format         = {{ dovecot_auth.username_format }}
{% endif %}
{% if dovecot_auth.master_user_separator is defined and
      dovecot_auth.master_user_separator | string | length > 0 %}
auth_master_user_separator   = {{ dovecot_auth.master_user_separator }}
{% endif %}
{% if dovecot_auth.anonymous_username is defined and
      dovecot_auth.anonymous_username | string | length > 0 %}
auth_anonymous_username      = {{ dovecot_auth.anonymous_username }}
{% endif %}
{% if dovecot_auth.gssapi_hostname is defined and
      dovecot_auth.gssapi_hostname | string | length > 0 %}
auth_gssapi_hostname         = {{ dovecot_auth.gssapi_hostname }}
{% endif %}
{% if dovecot_auth.krb5_keytab is defined and
      dovecot_auth.krb5_keytab | string | length > 0 %}
auth_krb5_keytab             = {{ dovecot_auth.krb5_keytab }}
{% endif %}
{% if dovecot_auth.use_winbind is defined and
      dovecot_auth.use_winbind | string | length > 0 %}
auth_use_winbind             = {{ dovecot_auth.use_winbind | bodsch.core.config_bool(true_as='yes', false_as='no') }}
{% endif %}
{% if dovecot_auth.winbind_helper_path is defined and
      dovecot_auth.winbind_helper_path | string | length > 0 %}
auth_winbind_helper_path     = {{ dovecot_auth.winbind_helper_path }}
{% endif %}
{% if dovecot_auth.failure_delay is defined and
      dovecot_auth.failure_delay | string | length > 0 %}
auth_failure_delay           = {{ dovecot_auth.failure_delay }}
{% endif %}
{% if dovecot_auth.ssl_require_client_cert is defined and
      dovecot_auth.ssl_require_client_cert | string | length > 0 %}
auth_ssl_require_client_cert = {{ dovecot_auth.ssl_require_client_cert | bodsch.core.config_bool(true_as='yes', false_as='no') }}
{% endif %}
{% if dovecot_auth.ssl_username_from_cert is defined and
      dovecot_auth.ssl_username_from_cert | string | length > 0 %}
auth_ssl_username_from_cert  = {{ dovecot_auth.ssl_username_from_cert | bodsch.core.config_bool(true_as='yes', false_as='no') }}
{% endif %}
{% if dovecot_auth.mechanisms is defined and
      dovecot_auth.mechanisms | count > 0 %}
{#  rpa, apop, otp and skey were dropped in 2.4; xoauth2 and oauthbearer were added #}
{% set _attr = [
  'plain', 'login',
  'digest-md5', 'cram-md5',
  'ntlm', 'anonymous',
  'gssapi', 'gss-spnego',
  'xoauth2', 'oauthbearer'] %}
auth_mechanisms              = {{ dovecot_auth.mechanisms | bodsch.core.compare_list(compare_to_list=_attr) | join(' ') }}
{% endif %}
{% if dovecot_auth.allow_weak_schemes is defined and
      dovecot_auth.allow_weak_schemes | string | length > 0 %}
auth_allow_weak_schemes      = {{ dovecot_auth.allow_weak_schemes | bodsch.core.config_bool(true_as='yes', false_as='no') }}
{% endif %}

{% if dovecot_auth.includes is defined and dovecot_auth.includes | count > 0 %}
{#
  A backend that is included but NOT configured renders a file without a single
  passdb, and dovecot does not complain about it - so it is reported here.

  The other direction is not an error: replacing the system backend the role
  ships means leaving auth-system.conf.ext out of includes, and its unused
  configuration then stays behind harmlessly.
#}
{% set _included = [] %}
{% for incl in dovecot_auth.includes | default([]) %}
  {% if incl | string | trim | first != '#' %}
    {% set _ = _included.append(incl | string | trim | regex_replace('^auth-', '') | regex_replace('\.conf\.ext$', '')) %}
  {% endif %}
{% endfor %}
{% set _configured = (dovecot_authentications | default({})).keys() | list %}
{% for _name in _included | sort if _name not in _configured %}
# NOTE auth-{{ _name }}.conf.ext is included but dovecot_authentications.{{ _name }}
#   is empty - the file renders without a passdb.
{% endfor %}
{{ mcr.include_paramaters(dovecot_auth.includes) }}
{% endif %}
