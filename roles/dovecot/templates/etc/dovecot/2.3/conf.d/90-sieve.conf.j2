#jinja2: trim_blocks: True, lstrip_blocks: True
# {{ ansible_managed }}

{#
  dovecot_sieve.plugins is a list of mappings that either hold the settings
  themselves or group them under a name of their own:

      - sieve: file:~/sieve              - default:
                                             sieve: file:~/sieve

  Both are written into one plugin { } block.
#}
{% set _settings = {} %}
{% for plugin in dovecot_sieve.plugins | default([]) if plugin | bodsch.core.type == "dict" %}
  {% for key, value in plugin.items() %}
    {% if value | bodsch.core.type == "dict" %}
      {% for k, v in value.items() %}
        {% set _ = _settings.update({k: v}) %}
      {% endfor %}
    {% else %}
      {% set _ = _settings.update({key: value}) %}
    {% endif %}
  {% endfor %}
{% endfor %}
{#
  The settings of dovecot_sieve_extprograms do nothing on their own:
  sieve_extprograms is a plugin of the sieve interpreter, and its extensions
  are only available to global scripts once listed in
  sieve_global_extensions. Each extension whose bin_dir or socket_dir is
  configured is switched on.

  This has to happen HERE and not in 90-sieve-extprograms.conf: that file is
  read first ("-" sorts before "."), so a sieve_plugins in this file would
  replace whatever it set.
#}
{% set _programs = [] %}
{% for plugin in dovecot_sieve_extprograms.plugins | default([]) if plugin | bodsch.core.type == "dict" %}
  {% for key, value in plugin.items() %}
    {% set _ext_settings = value if value | bodsch.core.type == "dict" else {key: value} %}
    {% for k, v in _ext_settings.items() if v | string | length > 0 %}
      {% for _program in ['pipe', 'filter', 'execute'] %}
        {% if k in ['sieve_' ~ _program ~ '_bin_dir', 'sieve_' ~ _program ~ '_socket_dir'] and _program not in _programs %}
          {% set _ = _programs.append(_program) %}
        {% endif %}
      {% endfor %}
    {% endfor %}
  {% endfor %}
{% endfor %}
{% if _programs | count > 0 %}
  {% set _raw = _settings.sieve_plugins | default('', true) %}
  {% set _tokens = ((([_raw] if _raw is string else _raw) | join(' ')) | string).split() %}
  {% set _ = _settings.update({'sieve_plugins': (_tokens + ['sieve_extprograms']) | unique | join(' ')}) %}
  {% set _raw = _settings.sieve_global_extensions | default('', true) %}
  {% set _tokens = ((([_raw] if _raw is string else _raw) | join(' ')) | string).split() %}
  {% for _program in _programs %}
    {% set _ = _tokens.append('+vnd.dovecot.' ~ _program) %}
  {% endfor %}
  {% set _ = _settings.update({'sieve_global_extensions': _tokens | unique | join(' ')}) %}
{% endif %}
{% if _settings | count > 0 %}
plugin {
  {% for key, value in _settings.items() %}
    {% if value | bodsch.core.type == "bool" %}
  {{ "%-27s" | format(key) }} = {{ value | bodsch.core.config_bool(true_as='yes', false_as='no') }}
    {% elif value | bodsch.core.type == "list" %}
      {% if value | count > 0 %}
  {{ "%-27s" | format(key) }} = {{ value | join(' ') }}
      {% endif %}
    {% elif value is not none and value | string | length > 0 %}
  {{ "%-27s" | format(key) }} = {{ value }}
    {% endif %}
  {% endfor %}
}
{% endif %}
