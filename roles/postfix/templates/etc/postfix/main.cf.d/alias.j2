{% set values = postfix_alias | bodsch.core.remove_empty_values() %}

# --[alias]------------------------------------------------
{% if values is defined and
      values | count > 0 %}

  {% if values.database is defined and
        values.database | string | length > 0 %}
alias_database                            = {{ values.database }}
  {% endif %}
  {% if values.maps is defined and
        values.maps | string | length > 0 %}
alias_maps                                = {{ values.maps }}
  {% endif %}
{% endif %}
# ---------------------------------------------------------
{#
# postconf | grep -E "^alias_"
alias_database = lmdb:/etc/aliases
alias_maps = lmdb:/etc/aliases
