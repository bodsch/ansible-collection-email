{% set values = postfix_tls | bodsch.core.remove_empty_values() %}

# --[tls]--------------------------------------------------
{% if values is defined and
      values | count > 0 %}

  {% if values.append_default_CA is defined and
        values.append_default_CA | string | length > 0 %}
tls_append_default_CA                     = {{ values.append_default_CA | bool | bodsch.core.config_bool(true_as='yes', false_as='no') }}
  {% endif %}
  {% if values.daemon_random_bytes is defined and
        values.daemon_random_bytes | string | length > 0 %}
tls_daemon_random_bytes                   = {{ values.daemon_random_bytes }}
  {% endif %}
  {% if values.dane_digests is defined and
        values.dane_digests | count > 0 %}
tls_dane_digests                          = {{ values.dane_digests | join(" ") }}
  {% endif %}
  {% if values.disable_workarounds is defined and
        values.disable_workarounds | count > 0 %}
    {% set valid_workarounds = [
          "CRYPTOPRO_TLSEXT_BUG","DONT_INSERT_EMPTY_FRAGMENTS","LEGACY_SERVER_CONNECT",
          "MICROSOFT_BIG_SSLV3_BUFFER","MICROSOFT_SESS_ID_BUG","MSIE_SSLV2_RSA_PADDING",
          "NETSCAPE_CHALLENGE_BUG","NETSCAPE_REUSE_CIPHER_CHANGE_BUG","SSLEAY_080_CLIENT_DH_BUG",
          "SSLREF2_REUSE_CERT_TYPE_BUG","TLS_BLOCK_PADDING_BUG","TLS_D5_BUG","TLS_ROLLBACK_BUG",
          "TLSEXT_PADDING"] %}
    {% set workarounds = values.disable_workarounds | bodsch.email.valid_list_data(valid_workarounds) %}
tls_disable_workarounds                   =
    {{ workarounds | join("\n") | indent(4) }}
  {% endif %}
  {% if values.eecdh_auto_curves is defined and
        values.eecdh_auto_curves | count > 0 %}
    {% if values.eecdh_auto_curves | bodsch.core.type == "list" %}
tls_eecdh_auto_curves                     = {{ values.eecdh_auto_curves | join(" ") }}
    {% else %}
tls_eecdh_auto_curves                     = {{ values.eecdh_auto_curves }}
    {% endif %}
  {% endif %}
  {% if values.eecdh_strong_curve is defined and
        values.eecdh_strong_curve | string | length > 0 %}
tls_eecdh_strong_curve                    = {{ values.eecdh_strong_curve }}
  {% endif %}
  {% if values.eecdh_ultra_curve is defined and
        values.eecdh_ultra_curve | string | length > 0 %}
tls_eecdh_ultra_curve                     = {{ values.eecdh_ultra_curve }}
  {% endif %}
  {% if values.export_cipherlist is defined and
        values.export_cipherlist | count > 0 %}
    {% if values.export_cipherlist | bodsch.core.type == "list" %}
tls_export_cipherlist                     = {{ values.export_cipherlist | join(":") }}
    {% else %}
tls_export_cipherlist                     = {{ values.export_cipherlist }}
    {% endif %}
  {% endif %}
  {% if values.fast_shutdown_enable is defined and
        values.fast_shutdown_enable | string | length > 0 %}
tls_fast_shutdown_enable                  = {{ values.fast_shutdown_enable | bool | bodsch.core.config_bool(true_as='yes', false_as='no') }}
  {% endif %}
  {% if values.high_cipherlist is defined and
        values.high_cipherlist | count > 0 %}
    {% if values.export_cipherlist | bodsch.core.type == "list" %}
tls_high_cipherlist                       = {{ values.high_cipherlist | join(":") }}
    {% else %}
tls_high_cipherlist                       = {{ values.high_cipherlist }}
    {% endif %}
  {% endif %}
  {% if values.legacy_public_key_fingerprints is defined and
        values.legacy_public_key_fingerprints | string | length > 0 %}
tls_legacy_public_key_fingerprints        = {{ values.legacy_public_key_fingerprints | bool | bodsch.core.config_bool(true_as='yes', false_as='no') }}
  {% endif %}
  {% if values.low_cipherlist is defined and
        values.low_cipherlist | count > 0 %}
    {% if values.low_cipherlist | bodsch.core.type == "list" %}
tls_low_cipherlist                        = {{ values.low_cipherlist | join(":") }}
    {% else %}
tls_low_cipherlist                        = {{ values.low_cipherlist }}
    {% endif %}
  {% endif %}
  {% if values.medium_cipherlist is defined and
        values.medium_cipherlist | count > 0 %}
    {% if values.medium_cipherlist | bodsch.core.type == "list" %}
tls_medium_cipherlist                     = {{ values.medium_cipherlist | join(":") }}
    {% else %}
tls_medium_cipherlist                     = {{ values.medium_cipherlist }}
    {% endif %}
  {% endif %}
  {% if values.null_cipherlist is defined and
        values.null_cipherlist | count > 0 %}
    {% if values.null_cipherlist | bodsch.core.type == "list" %}
tls_null_cipherlist                       = {{ values.null_cipherlist | join(":") }}
    {% else %}
tls_null_cipherlist                       = {{ values.null_cipherlist }}
    {% endif %}
  {% endif %}
  {% if values.preempt_cipherlist is defined and
        values.preempt_cipherlist | string | length > 0 %}
tls_preempt_cipherlist                    = {{ values.preempt_cipherlist | bool | bodsch.core.config_bool(true_as='yes', false_as='no') }}
  {% endif %}
  {% if values.random_bytes is defined and
        values.random_bytes | string | length > 0 %}
tls_random_bytes                          = {{ values.random_bytes }}
  {% endif %}
  {% if values.random_exchange_name is defined and
        values.random_exchange_name | string | length > 0 %}
tls_random_exchange_name                  = {{ values.random_exchange_name }}
  {% endif %}
  {% if values.random_prng_update_period is defined and
        values.random_prng_update_period | string | length > 0 %}
tls_random_prng_update_period             = {{ values.random_prng_update_period }}
  {% endif %}
  {% if values.random_reseed_period is defined and
        values.random_reseed_period | string | length > 0 %}
tls_random_reseed_period                  = {{ values.random_reseed_period }}
  {% endif %}
  {% if values.random_source is defined and
        values.random_source | string | length > 0 %}
tls_random_source                         = {{ values.random_source }}
  {% endif %}
  {% if values.server_sni_maps is defined and
        values.server_sni_maps | string | length > 0 %}
tls_server_sni_maps                       = {{ values.server_sni_maps }}
  {% endif %}
  {% if values.session_ticket_cipher is defined and
        values.session_ticket_cipher | string | length > 0 %}
tls_session_ticket_cipher                 = {{ values.session_ticket_cipher }}
  {% endif %}
  {% if values.ssl_options is defined and
        values.ssl_options | count > 0 %}
    {% set valid_ssl_options = [
          "ENABLE_MIDDLEBOX_COMPAT","LEGACY_SERVER_CONNECT","NO_TICKET","NO_COMPRESSION",
          "NO_RENEGOTIATION","NO_SESSION_RESUMPTION_ON_RENEGOTIATION","PRIORITIZE_CHACHA"] %}
    {% set ssl_options = values.ssl_options | bodsch.email.valid_list_data(valid_ssl_options) %}
tls_ssl_options                           =
    {{ ssl_options | join("\n") | indent(4) }}
  {% endif %}
  {% if values.wildcard_matches_multiple_labels is defined and
        values.wildcard_matches_multiple_labels | string | length > 0 %}
tls_wildcard_matches_multiple_labels      = {{ values.wildcard_matches_multiple_labels | bool | bodsch.core.config_bool(true_as='yes', false_as='no') }}
  {% endif %}
  {% if values.tlsmgr_service_name is defined and
        values.tlsmgr_service_name | string | length > 0 %}
tlsmgr_service_name                       = {{ values.tlsmgr_service_name }}
  {% endif %}
{% endif %}
# ---------------------------------------------------------
{#
tls_append_default_CA = no
tls_daemon_random_bytes = 32
tls_dane_digests = sha512 sha256
tls_disable_workarounds =
tls_eecdh_auto_curves = X25519 X448 prime256v1 secp521r1 secp384r1
tls_eecdh_strong_curve = prime256v1
tls_eecdh_ultra_curve = secp384r1
tls_export_cipherlist = aNULL:-aNULL:HIGH:MEDIUM:LOW:EXPORT:+RC4:@STRENGTH
tls_fast_shutdown_enable = yes
tls_high_cipherlist = aNULL:-aNULL:HIGH:@STRENGTH
tls_legacy_public_key_fingerprints = no
tls_low_cipherlist = aNULL:-aNULL:HIGH:MEDIUM:LOW:+RC4:@STRENGTH
tls_medium_cipherlist = aNULL:-aNULL:HIGH:MEDIUM:+RC4:@STRENGTH
tls_null_cipherlist = eNULL:!aNULL
tls_preempt_cipherlist = yes
tls_random_bytes = 32
tls_random_exchange_name = ${data_directory}/prng_exch
tls_random_prng_update_period = 3600s
tls_random_reseed_period = 3600s
tls_random_source = dev:/dev/urandom
tls_server_sni_maps =
tls_session_ticket_cipher = aes-256-cbc
tls_ssl_options =
tls_wildcard_matches_multiple_labels = yes
tlsmgr_service_name = tlsmgr
#}
