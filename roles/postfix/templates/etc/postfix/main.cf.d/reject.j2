{% set values = postfix_reject | bodsch.core.remove_empty_values() %}

# --[reject]-----------------------------------------------
{% if values is defined and
      values | count > 0 %}
# {{ values }}
# {{ values | count }}

  {% if values.code is defined and
        values.code | string | length > 0 %}
reject_code                               = {{ values.code }}
  {% endif %}
  {% if values.tempfail_action is defined and
        values.tempfail_action | string | length > 0 %}
reject_tempfail_action                    = {{ values.tempfail_action }}
  {% endif %}
{% endif %}
