{% set values = postfix_maillog | bodsch.core.remove_empty_values() %}

# --[maillog]----------------------------------------------
{% if values is defined and
      values | count > 0 %}

  {% if values.file is defined and
        values.file | string | length > 0 %}
maillog_file                              = {{ values.file }}
  {% endif %}
  {% if values.file_compressor is defined and
        values.file_compressor | string | length > 0 %}
maillog_file_compressor                   = {{ values.file_compressor }}
  {% endif %}
  {% if values.file_prefixes is defined and
        values.file_prefixes | length > 0 %}
maillog_file_prefixes                     = {{ values.file_prefixes | join(", ") }}
  {% endif %}
  {% if values.file_rotate_suffix is defined and
        values.file_rotate_suffix | string | length > 0 %}
maillog_file_rotate_suffix                = {{ values.file_rotate_suffix }}
  {% endif %}
{% endif %}
