{% set values = postfix_sender | bodsch.core.remove_empty_values() %}

# --[sender]-----------------------------------------------
{% if values is defined and
      values | count > 0 %}

  {% if values.bcc_maps is defined and
        values.bcc_maps | length > 0 %}
    {% if values.bcc_maps | bodsch.core.type == "list" %}
sender_bcc_maps                           =
    {{ values.bcc_maps | join("\n") | indent(4) }}
    {% else %}
sender_bcc_maps                           = {{ values.bcc_maps }}
    {% endif %}
  {% endif %}
  {% if values.canonical_classes is defined and
        values.canonical_classes | length > 0 %}
    {% if values.canonical_classes | bodsch.core.type == "list" %}
sender_canonical_classes                  =
    {{ values.canonical_classes | join("\n") | indent(4) }}
    {% else %}
sender_canonical_classes                  = {{ values.canonical_classes }}
    {% endif %}
  {% endif %}
  {% if values.canonical_maps_file is defined and
        values.canonical_maps_file | length > 0 %}
    {% if values.canonical_maps_file | bodsch.core.type == "list" %}
sender_canonical_maps                     =
    {{ values.canonical_maps_file | join("\n") | indent(4)  }}
    {% else %}
sender_canonical_maps                     = {{ values.canonical_maps_file }}
    {% endif %}
  {% endif %}
  {% if values.dependent_default_transport_maps is defined and
        values.dependent_default_transport_maps | length > 0 %}
    {% if values.dependent_default_transport_maps | bodsch.core.type == "list" %}
sender_dependent_default_transport_maps   =
    {{ values.dependent_default_transport_maps | join("\n") | indent(4)  }}
    {% else %}
sender_dependent_default_transport_maps   = {{ values.dependent_default_transport_maps }}
    {% endif %}
  {% endif %}
  {% if values.dependent_relayhost_maps_file is defined and
        values.dependent_relayhost_maps_file | length > 0 %}
    {% if values.dependent_relayhost_maps_file | bodsch.core.type == "list" %}
sender_dependent_relayhost_maps           =
    {{ values.dependent_relayhost_maps_file | join("\n") | indent(4)  }}
    {% else %}
sender_dependent_relayhost_maps           = {{ values.dependent_relayhost_maps_file }}
    {% endif %}
  {% endif %}
{% endif %}
# ---------------------------------------------------------
{#
sender_bcc_maps =
sender_canonical_classes = envelope_sender, header_sender
sender_canonical_maps = hash:/etc/postfix/maps.d/sender_canonical_maps
sender_dependent_default_transport_maps =
sender_dependent_relayhost_maps =
#}
