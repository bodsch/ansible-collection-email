{% set values = postfix_inet | bodsch.core.remove_empty_values() %}

# --[inet]-------------------------------------------------
{% if values is defined and
      values | count > 0 %}

  {% if values.interfaces is defined and
        values.interfaces | length > 0 %}
    {% if values.interfaces is string %}
inet_interfaces                           = {{ values.interfaces }}
    {% else %}
inet_interfaces                           = {{ values.interfaces | join(", ") }}
    {% endif %}
  {% endif %}
  {% if values.protocols is defined and
        values.protocols | length > 0 %}
    {% if values.protocols is string %}
inet_protocols                            = {{ values.protocols }}
    {% else %}
inet_protocols                            = {{ values.protocols | join(", ") }}
    {% endif %}
  {% endif %}
{% endif %}
# ---------------------------------------------------------
