{% set values = postfix_transport | bodsch.core.remove_empty_values() %}

# --[transport]--------------------------------------------
{% if values is defined and
      values | count > 0 %}

  {% if values.maps is defined  and
        values.maps | count > 0 %}
    {% if values.maps | bodsch.core.type == "list" %}
transport_maps                            =
    {{ values.maps | join("\n") | indent(4) }}
    {% else %}
transport_maps                            = {{ values.maps }}
    {% endif %}
  {% endif %}
  {% if values.retry_time is defined  and
        values.retry_time | string | length > 0 %}
transport_retry_time                      = {{ values.retry_time }}
  {% endif %}
{% endif %}
# ---------------------------------------------------------
{#
transport_maps =
transport_retry_time = 60s
#}
