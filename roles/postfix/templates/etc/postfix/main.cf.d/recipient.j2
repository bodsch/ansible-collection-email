{% set values = postfix_recipient | bodsch.core.remove_empty_values() %}

# --[recipient]--------------------------------------------
{% if values is defined and
      values | count > 0 %}

  {% if values.bcc_maps is defined and
        values.bcc_maps | string | length > 0 %}
recipient_bcc_maps                        = {{ values.bcc_maps }}
  {% endif %}
  {% if values.canonical_classes is defined and
        values.canonical_classes | string | length > 0 %}
recipient_canonical_classes               = {{ values.canonical_classes }}
  {% endif %}
  {% if values.canonical_maps_files is defined and
        values.canonical_maps_files | length > 0 %}
    {% if values.canonical_maps_files is string %}
recipient_canonical_maps                  = {{ values.canonical_maps_files }}
    {% else %}
recipient_canonical_maps                  =
      {{ values.canonical_maps_files | join("\n") | indent(4) }}
    {% endif %}
  {% endif %}
  {% if values.delimiter is defined and
        values.delimiter | string | length > 0 %}
recipient_delimiter                       = {{ values.delimiter }}
  {% endif %}
{% endif %}
# ---------------------------------------------------------
{#
#}
