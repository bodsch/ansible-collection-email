{% set values = postfix_relay | bodsch.core.remove_empty_values() %}

# --[relay]------------------------------------------------
{% if values is defined and
      values | count > 0 %}

  {% if values.clientcerts is defined and
        values.clientcerts | string | length > 0 %}
relay_clientcerts                         = {{ values.clientcerts }}
  {% endif %}
  {% if values.delivery_slot_cost is defined and
        values.delivery_slot_cost | string | length > 0 %}
relay_delivery_slot_cost                  = {{ values.delivery_slot_cost }}
  {% endif %}
  {% if values.delivery_slot_discount is defined and
        values.delivery_slot_discount | string | length > 0 %}
relay_delivery_slot_discount              = {{ values.delivery_slot_discount }}
  {% endif %}
  {% if values.delivery_slot_loan is defined and
        values.delivery_slot_loan | string | length > 0 %}
relay_delivery_slot_loan                  = {{ values.delivery_slot_loan }}
  {% endif %}
  {% if values.destination_concurrency_failed_cohort_limit is defined and
        values.destination_concurrency_failed_cohort_limit | string | length > 0 %}
relay_destination_concurrency_failed_cohort_limit = {{ values.destination_concurrency_failed_cohort_limit }}
  {% endif %}
  {% if values.destination_concurrency_limit is defined and
        values.destination_concurrency_limit | string | length > 0 %}
relay_destination_concurrency_limit       = {{ values.destination_concurrency_limit }}
  {% endif %}
  {% if values.destination_concurrency_negative_feedback is defined and
        values.destination_concurrency_negative_feedback | string | length > 0 %}
relay_destination_concurrency_negative_feedback = {{ values.destination_concurrency_negative_feedback }}
  {% endif %}
  {% if values.destination_concurrency_positive_feedback is defined and
        values.destination_concurrency_positive_feedback | string | length > 0 %}
relay_destination_concurrency_positive_feedback = {{ values.destination_concurrency_positive_feedback }}
  {% endif %}
  {% if values.destination_rate_delay is defined and
        values.destination_rate_delay | string | length > 0 %}
relay_destination_rate_delay              = {{ values.destination_rate_delay }}
  {% endif %}
  {% if values.destination_recipient_limit is defined and
        values.destination_recipient_limit | string | length > 0 %}
relay_destination_recipient_limit         = {{ values.destination_recipient_limit }}
  {% endif %}
  {% if values.domains is defined and
        values.domains | length > 0 %}
    {% if values.domains | bodsch.core.type == "list" %}
relay_domains                             =
    {{ values.domains | join("\n") | indent(4)  }}
    {% else %}
relay_domains                             = {{ values.domains }}
    {% endif %}
  {% endif %}
{# obsolete
{% if values.domains and
      values.domains | string | length > 0 %}
relay_domains                             = {{ values.domains }}
{% endif %}
#}
 {% if values.domains_reject_code is defined and
       values.domains_reject_code | string | length > 0 %}
relay_domains_reject_code                 = {{ values.domains_reject_code }}
  {% endif %}
  {% if values.extra_recipient_limit is defined and
        values.extra_recipient_limit | string | length > 0 %}
relay_extra_recipient_limit               = {{ values.extra_recipient_limit }}
  {% endif %}
  {% if values.initial_destination_concurrency is defined and
        values.initial_destination_concurrency | string | length > 0 %}
relay_initial_destination_concurrency     = {{ values.initial_destination_concurrency }}
  {% endif %}
  {% if values.minimum_delivery_slots is defined and
        values.minimum_delivery_slots | string | length > 0 %}
relay_minimum_delivery_slots              = {{ values.minimum_delivery_slots }}
  {% endif %}
  {% if values.recipient_limit is defined and
        values.recipient_limit | string | length > 0 %}
relay_recipient_limit                     = {{ values.recipient_limit }}
  {% endif %}
  {% if values.recipient_maps is defined and
        values.recipient_maps | length > 0 %}
    {% if values.recipient_maps | bodsch.core.type == "list" %}
relay_recipient_maps                      =
    {{ values.recipient_maps | join("\n") | indent(4)  }}
    {% else %}
relay_recipient_maps                        = {{ values.recipient_maps }}
    {% endif %}
  {% endif %}
{# obsolete
{% if values.recipient_maps_file and
      values.recipient_maps_file | string | length > 0 %}
relay_recipient_maps                      = {{ values.recipient_maps_file }}
{% endif %}
#}
  {% if values.recipient_refill_delay is defined and
        values.recipient_refill_delay | string | length > 0 %}
relay_recipient_refill_delay              = {{ values.recipient_refill_delay }}
  {% endif %}
  {% if values.recipient_refill_limit is defined and
        values.recipient_refill_limit | string | length > 0 %}
relay_recipient_refill_limit              = {{ values.recipient_refill_limit }}
  {% endif %}
  {% if values.transport is defined and
        values.transport | string | length > 0 %}
relay_transport                           = {{ values.transport }}
  {% endif %}
  {% if values.transport_rate_delay is defined and
        values.transport_rate_delay | string | length > 0 %}
relay_transport_rate_delay                = {{ values.transport_rate_delay }}
  {% endif %}
  {% if values.host is defined and
        values.host | length > 0 %}
    {# TODO
      # https://www.postfix.org/postconf.5.html#relayhost
        Multiple destinations are supported in Postfix 3.5 and later.
    #}
    {% if values.mxlookup is defined and
          values.mxlookup | string | length > 0 and
          values.mxlookup | bool %}
relayhost                                 = {{ values.host }}:{{ values.port }}
    {% else %}
relayhost                                 = [{{ values.host }}]:{{ values.port }}
    {% endif %}
  {% else %}
relayhost                                 =
  {% endif %}
{% endif %}
# ---------------------------------------------------------
{#
#}
