#jinja2: trim_blocks: True, lstrip_blocks: True
# {{ ansible_managed }}

{% set values = mailmonkey_acme | bodsch.email.mailmonkey_acme_passwords() %}
{% set values = values | bodsch.core.remove_empty_values() %}

# mailmonkey-acme configuration — /etc/mailmonkey/acme.yaml

# ---------------------------------------------------------------- logging ----
log:
{% set _log_level = "info" %}
{% set _log_format = "text" %}
{% if values.log.level is defined and
      values.log.level | string | length > 0 and
      values.log.level in ["debug", "info", "warn", "error"] %}
  {% set _log_level = values.log.level %}
  level: {{ _log_level }}
{% endif %}
{% if values.log.format is defined and
      values.log.format | string | length > 0 and
      values.log.format in ["text", "json"] %}
  {% set _log_format = values.log.format %}
  format: {{ _log_format }}
{% endif %}

# --------------------------------------------------------------- database ----
{% if (values.db.socket | default('') | string | length > 0) or
      (values.db.host | default('') | string | length > 0)  %}
  {% if values.db.host | default('') | string | length > 0 %}
    {% set _ = values.db.pop("socket") %}
  {% endif %}
db:
  {% if values.db.socket | default('') | string | length > 0 %}
  socket: {{ values.db.socket }}
  {% endif %}
  {% if values.db.host | default('') | string | length > 0 %}
  host: {{ values.db.host }}
  port: {{ values.db.port | default(3306) | int }}
  {% endif %}
  {% if values.db.name | default('mailmonkey') | string | length > 0 %}
  name: {{ values.db.name }}
  {% endif %}
  {% if values.db.user | default('mailmonkey') | string | length > 0 %}
  user: {{ values.db.user }}
  {% endif %}
  {% if values.db.password_file | default('') | string | length > 0 %}
  password_file: {{ values.db.password_file }}
  {% endif %}
{% else %}
# no database configuration found
{% endif %}

# ------------------------------------------------------------- the mail host --
{% if values.mail.hostname | default('') | string | length > 0 %}
mail:
  hostname: {{ values.mail.hostname }}
  {% if values.mail.ipv4 | default('') | string | length > 0 %}
  ipv4: {{ values.mail.ipv4 }}
  {% endif %}
  {% if values.mail.ipv6 | default('') | string | length > 0 %}
  ipv6: {{ values.mail.ipv6 }}
  {% endif %}
{% endif %}

# ---------------------------------------------------------------- MTA-STS -----
{% if values.mta_sts is defined and
      values.mta_sts | count > 0 %}
mta_sts:
  {% if values.mta_sts.mode | default('') | string | length > 0 and
        values.mta_sts.mode in ["none", "testing", "enforce"] %}
    {% set _mta_sts_mode = values.mta_sts.mode %}
  mode: {{ _mta_sts_mode }}
    {% if values.mta_sts.max_age | default('') | string | length > 0 %}
  max_age: {{ values.mta_sts.max_age }}
    {% endif %}
  {% endif %}
{% endif %}

# ---------------------------------------------------------------- ACME --------
{% if values.acme is defined and
      values.acme | count > 0 %}
acme:
  metrics_listen: "{{ values.acme.get('metrics_listen', '') }}"
  {% if values.acme.cert_dir | default('') | string | length > 0 %}
  cert_dir: {{ values.acme.cert_dir }}
  {% endif %}
  {% if values.acme.fallback_dir | default('') | string | length > 0 %}
  fallback_dir: {{ values.acme.fallback_dir }}
  {% endif %}
  {% if values.acme.staging | default('') | string | length > 0 %}
  staging: {{ values.acme.staging | bool | bodsch.core.config_bool(true_as='true', false_as='false') }}
  {% endif %}
  {% if values.acme.contact | default('') | string | length > 0 %}
  contact: {{ values.acme.contact }}
  {% endif %}
  {% if values.acme.webroot | default('') | string | length > 0 %}
  webroot: {{ values.acme.webroot }}
  {% endif %}
  {% if values.acme.resolver | default('') | string | length > 0 %}
  resolver: {{ values.acme.resolver }}
  {% endif %}
  {% if values.acme.reload_units | default([]) | count > 0 %}
  reload_units: {{ values.acme.reload_units | to_nice_yaml(indent=0,sort_keys=False) | indent(2, False) }}
  {% endif %}
  {#  ----- #}
  {% if values.acme.dns is defined and
        values.acme.dns | count > 0 %}
  dns:
    {% if values.acme.dns.challenge | default('') | string | length > 0 %}
    challenge: {{ values.acme.dns.challenge | bool | bodsch.core.config_bool(true_as='true', false_as='false') }}
    {% endif %}
    {% if values.acme.dns.provider | default('') | string | length > 0 %}
    provider: {{ values.acme.dns.provider }}
    {% endif %}
    {% if values.acme.dns.config | default('') | string | length > 0 %}
    config: {{ values.acme.dns.config }}
    {% endif %}
  {% endif %}
  {% if values.acme.certificate is defined and
        values.acme.certificate | count > 0 %}
  certificate:
    {% if values.acme.certificate.additional_san | default([]) | count > 0 %}
    additional_san: {{ values.acme.certificate.additional_san | to_nice_yaml(indent=0,sort_keys=False) | indent(2, False) }}
    {% endif %}
    {% if values.acme.certificate.only_hostname | default('') | string | length > 0 %}
    only_hostname: {{ values.acme.certificate.only_hostname | bool | bodsch.core.config_bool(true_as='true', false_as='false') }}
    {% endif %}
    {% if values.acme.certificate.autodiscover_san | default('') | string | length > 0 %}
    autodiscover_san: {{ values.acme.certificate.autodiscover_san | bool | bodsch.core.config_bool(true_as='true', false_as='false') }}
    {% endif %}
    {% if values.acme.certificate.sni | default('') | string | length > 0 %}
    sni: {{ values.acme.certificate.sni | bool | bodsch.core.config_bool(true_as='true', false_as='false') }}
    {% endif %}
    {% if values.acme.certificate.skip_ip_check | default('') | string | length > 0 %}
    skip_ip_check: {{ values.acme.certificate.skip_ip_check | bool | bodsch.core.config_bool(true_as='true', false_as='false') }}
    {% endif %}
    {% if values.acme.certificate.skip_http_verification | default('') | string | length > 0 %}
    skip_http_verification: {{ values.acme.certificate.skip_http_verification | bool | bodsch.core.config_bool(true_as='true', false_as='false') }}
    {% endif %}
    {% if values.acme.certificate.keep_backups | default('') | string | length > 0 %}
    keep_backups: {{ values.acme.certificate.keep_backups | int }}
    {% endif %}
    {% if values.acme.certificate.renew_before | default('') | string | length > 0 %}
    renew_before: {{ values.acme.certificate.renew_before }}
    {% endif %}
  {% endif %}
  {% if values.acme.timing is defined and
        values.acme.timing | count > 0 %}
  timing:
    {% if values.acme.timing.check_interval | default('') | string | length > 0 %}
    check_interval: {{ values.acme.timing.check_interval }}
    {% endif %}
    {% if values.acme.timing.retry_interval | default('') | string | length > 0 %}
    retry_interval: {{ values.acme.timing.retry_interval }}
    {% endif %}
    {% if values.acme.timing.stall_interval | default('') | string | length > 0 %}
    stall_interval: {{ values.acme.timing.stall_interval }}
    {% endif %}
    {% if values.acme.timing.verify_settle | default('') | string | length > 0 %}
    verify_settle: {{ values.acme.timing.verify_settle }}
    {% endif %}
    {% if values.acme.timing.verify_attempts | default('') | string | length > 0 %}
    verify_attempts: {{ values.acme.timing.verify_attempts | int }}
    {% endif %}
  {% endif %}
{% endif %}

{#
log:
  level: info          # debug | info | warn | error
  format: json         # json | text  (json for journald, text to read)

# Usually a narrower account than the web service's: this service reads the
# domain list and writes nothing but its own state.
db:
  socket: /run/mysqld/mysqld.sock
  # host: 127.0.0.1                        # (instead of socket)
  # port: 3306                             # (with host; default 3306)
  user: mailmonkey_acme
  # password: secret
  password_file: /etc/mailmonkey/acme-db-password
  name: mailmonkey                         # (default mailmonkey)
  # dsn: mailmonkey_acme:secret@unix(/run/mysqld/mysqld.sock)/mailmonkey   # instead of the parts
  # dsn_file: /etc/mailmonkey/acme-db-dsn

# The same values as in mailmonkey.yaml.
mail:
  hostname: mx.example.com                 # the certificate's primary name
  ipv4: 203.0.113.25                       # answers the pre-flight IP check without
  # ipv6: "2001:db8::25"                   #   asking anybody for this host's address

mta_sts:
  mode: ""                                 # none | testing | enforce
  max_age: 604800

acme:
  metrics_listen: ""
  cert_dir: /var/lib/mailmonkey/certs
  # Where the generated placeholder pair lives; defaults to <cert_dir>/placeholder.
  # fallback_dir: /var/lib/mailmonkey/certs/placeholder

  # Use staging while setting a deployment up. Let's Encrypt's production rate
  # limits are low enough that one typo locks you out for a week.
  #
  # true selects Let's Encrypt's staging CA. Mutually exclusive with
  # directory_url, which names any ACME CA; the store records which one issued
  # each certificate and replaces them when it changes.
  staging: false
  # directory_url: https://acme-v02.api.letsencrypt.org/directory

  # The address the CA writes to about expiry. Optional, and worth setting: it is
  # the only warning anyone gets if this service stops running.
  contact: postmaster@example.com

  # Where the HTTP-01 challenge is written, served by whatever fronts port 80.
  webroot: /var/www/acme

  # The resolver the pre-flight checks ask. Stated rather than taken from the
  # host, so a stale local cache does not make every check disagree with the
  # world.
  resolver: "1.1.1.1:53"

  # The systemd units told to pick up a new certificate.
  reload_units: [postfix, dovecot]

  # DNS-01 instead of HTTP-01. The only way to obtain a wildcard, and the only
  # way that works when port 80 is not reachable.
  dns:
    challenge: false
    provider: ""                           # a lego provider name, e.g. cloudflare
    # KEY=value lines, put into the process environment at start, because lego's
    # providers read their credentials there. The one place this service takes
    # anything from the environment; see documentation/deployment.md.
    config: ""                             # path to that provider's credentials

  certificate:
    # Extra names. An entry ending in ".*" is a subdomain label added to every
    # domain rather than a name of its own.
    additional_san: []

    # Request nothing but the mail hostname, ignoring the database. How a
    # deployment is brought up before its domains exist.
    only_hostname: false

    # autoconfig, autodiscover and mta-sts for every domain. On by default,
    # because this program serves those endpoints itself and a certificate
    # missing them makes them unusable — without anything failing loudly.
    autodiscover_san: true

    # One certificate per domain instead of one carrying every name.
    sni: false

    # Waive a pre-flight check. For deployments where the check cannot succeed
    # even though issuance can — behind a NAT the detector cannot see through.
    skip_ip_check: false
    skip_http_verification: false

    # How many replaced copies a certificate keeps. 0 means unlimited.
    keep_backups: 10

    # How long before expiry to renew.
    renew_before: 720h

  # The pauses between runs, by outcome.
  timing:
    check_interval: 1h                     # nothing to do
    retry_interval: 10m                    # the run failed
    stall_interval: 6h                     # nothing could be validated at all — longer,
                                           #   because the cause is usually DNS somebody
                                           #   has to go and change
    verify_settle: 10s                     # wait after a reload before asking what the
                                           #   services present
    verify_attempts: 3
#}
